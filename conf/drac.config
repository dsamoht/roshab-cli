/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for the Digital Research Alliance of Canada clusters
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Use as follows:
        nextflow run dsamoht/roshab-cli -profile drac,apptainer --input samplesheet.csv --outdir <OUTDIR>

    Set your allocation with --clusterOptions or by editing the account below.

    The clusters have no Docker: pair this profile with `apptainer` (or `singularity`).
    `$HOME` is small and shared by every job, so point the image cache at a project or
    scratch directory before launching:
        module load apptainer
        export NXF_APPTAINER_CACHEDIR=/project/<your-group>/apptainer_cache
    Images are pulled on the login node when the run starts, not by the compute jobs.
----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'DRAC profile'
    config_profile_description = 'Digital Research Alliance of Canada clusters (slurm)'
    config_profile_url         = 'https://docs.alliancecan.ca'
}

process {
    executor       = 'slurm'
    clusterOptions = '--account=def-PI' // modify this line
    errorStrategy  = { task.exitStatus in ((130..145) + 104 + (175..177)) ? 'retry' : 'finish' }
    maxRetries     = 3
    maxErrors      = '-1'
    time           = { 24.h * task.attempt }

    withLabel: 'process_single' {
        cpus   = { 1                    }
        memory = { 8.GB  * task.attempt }
    }
    withLabel: 'process_low' {
        cpus   = { 4     * task.attempt }
        memory = { 16.GB * task.attempt }
    }
    withLabel: 'process_medium' {
        cpus   = { 16    * task.attempt }
        memory = { 64.GB * task.attempt }
    }
    withLabel: 'process_high' {
        cpus   = 20
        memory = { 128.GB * task.attempt }
    }
    // The database downloads (INSTALL_DB, ANTISMASH_DOWNLOAD, DEEPBGC_DOWNLOAD) are the
    // only long steps, and they are single-threaded: give them walltime, not cores.
    withLabel: 'process_long' {
        cpus   = { 1                   }
        time   = { 24.h * task.attempt }
    }
}
