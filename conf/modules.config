/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.

    NOTE: publishing is declared in the `output` block of `main.nf` using the
    Nextflow workflow output definition, not with `publishDir` here.
----------------------------------------------------------------------------------------
*/

process {

    //
    // Read QC
    //
    withName: 'CHOPPER' {
        ext.args   = { [
            "--headcrop ${params.chopper_headcrop}",
            "--tailcrop ${params.chopper_tailcrop}",
            "-l ${params.chopper_minlength}",
            "-q ${params.chopper_minq}",
        ].join(' ') }
        ext.prefix = { "${meta.id}.choppered" }
    }

    withName: 'NANOPLOT_RAW' {
        ext.prefix = { "${meta.id}_raw" }
    }

    withName: 'NANOPLOT_QC' {
        ext.prefix = { "${meta.id}_qc" }
    }

    //
    // Taxonomic profiling
    //
    withName: 'SEQKIT_SLIDING' {
        ext.args   = { "--step ${params.bracken_length} --window ${params.bracken_length}" }
        ext.prefix = { "${meta.id}.${params.bracken_length}bp" }
    }

    withName: 'BRACKEN' {
        ext.args = { "-r ${params.bracken_length} -l S" }
    }

    withName: 'KRAKENTOOLS_KREPORT2MPA' {
        ext.args = '--intermediate-ranks --display-header'
    }

    withName: 'COVERM' {
        ext.args = '--mapper minimap2-ont --methods mean trimmed_mean count --min-covered-fraction 0'
    }

    //
    // Read-level cyanotoxin screening
    //
    withName: 'DIAMOND_BLASTX' {
        ext.args   = { "--long-reads --sensitive --id ${params.diamond_blastx_id}" }
        ext.prefix = { "${meta.id}.diamond" }
    }

    //
    // Assembly
    //
    withName: 'FLYE' {
        ext.args = { "--nano-hq --meta ${params.flye_args ?: ''}".trim() }
    }

    withName: 'METAMDBG' {
        ext.args = { params.metamdbg_args ?: '' }
    }

    withName: 'MEDAKA' {
        ext.args = { params.medaka_model ? "-m ${params.medaka_model}" : '' }
    }

    withName: 'SEQKIT_SEQ' {
        ext.args   = { "--min-len ${params.min_contig_length}" }
        ext.prefix = { "${meta.id}.filtered" }
    }

    withName: 'SEQKIT_STATS' {
        ext.args   = '--all --tabular'
        ext.prefix = { "${meta.id}.assembly_stats" }
    }

    // Assembly and antiSMASH are the heavy steps of the `assembly` route.
    // `--assembly_cpus` overrides the `process_high` CPU default for them;
    // memory and time still come from the label, so set them in a custom
    // config (`-c my.config`) when running on a scheduler.
    withName: 'FLYE|METAMDBG|MEDAKA|ANTISMASH' {
        cpus = { params.assembly_cpus ? params.assembly_cpus as int : 12 * task.attempt }
    }

    //
    // Contig-level cyanotoxin screening
    //
    withName: 'PYRODIGAL' {
        ext.args = '-p meta'
    }

    withName: 'DIAMOND_BLASTP' {
        ext.args   = { "--sensitive --id ${params.diamond_blastp_id}" }
        ext.prefix = { "${meta.id}.diamond" }
    }

    withName: 'ANTISMASH' {
        ext.args = { [
            '--taxon bacteria',
            "--genefinding-tool ${params.antismash_genefinding}",
            '--cb-knownclusters',
            '--cc-mibig',
            "--minlength ${params.min_contig_length}",
        ].join(' ') }
    }

    withName: 'MERGE_BGC' {
        ext.args = { "--min-overlap ${params.bgc_min_overlap}" }
    }

    //
    // Figures
    //
    withName: 'PLOT_GENE_DIAMOND_READS' {
        ext.prefix = { "group_${group_id}_cyanotoxins_heatmap" }
    }

    withName: 'PLOT_GENE_DIAMOND_CONTIGS' {
        ext.prefix = { "group_${group_id}_contigs_cyanotoxins_heatmap" }
    }

    //
    // Reporting
    //
    withName: 'MULTIQC' {
        ext.args = { params.multiqc_title ? "--title \"${params.multiqc_title}\"" : '' }
    }

}
